{
  "production_protocol": {
    "routes": {
      "ping": { "method": "GET", "path": "/api/ping" },
      "settings": { "method": "GET", "path": "/api/settings/" },
      "workspaces": { "method": "GET", "path": "/api/workspaces" },
      "active_workspace": { "method": "POST", "path": "/api/system/active-workspace" },
      "sessions": { "method": "GET", "path": "/api/sessions?scope=all" },
      "companion_runtime": { "method": "GET", "path": "/api/system/companion-runtime?limit={limit}" }
    },
    "socket_events": {
      "AUDIO_CHUNK": "audio:chunk",
      "ASR_VAD_START": "asr:vad-start",
      "ASR_SPEECH_START": "asr:speech-start",
      "ASR_PARTIAL": "asr:partial",
      "ASR_FINAL": "asr:final",
      "LLM_REQUEST": "llm:request",
      "LLM_DELTA": "llm:delta",
      "LLM_FINAL": "llm:final",
      "TTS_CHUNK": "tts:chunk",
      "TTS_DONE": "tts:done",
      "SVC_CONVERT": "svc:convert",
      "SVC_DONE": "svc:done",
      "TOOL_CALL": "tool:call",
      "TOOL_RESULT": "tool:result",
      "TOOL_ERROR": "tool:error",
      "AGENT_CHAT": "agent:chat",
      "AGENT_UPDATE": "agent:update",
      "AGENT_RESULT": "agent:result",
      "MEMORY_STATUS": "memory:status",
      "RAG_QUERY": "rag:query",
      "RAG_RESULT": "rag:result",
      "SCREENSHOT_REQUEST": "screenshot:request",
      "SCREENSHOT_RESULT": "screenshot:result",
      "PET_STATE": "pet:state",
      "PET_INTERACT": "pet:interact",
      "PET_CONTROL": "pet:control",
      "CONNECT": "connect",
      "DISCONNECT": "disconnect",
      "HEARTBEAT": "heartbeat",
      "INTERRUPT": "interrupt",
      "INTERRUPT_ACK": "interrupt:ack",
      "LATENCY": "system:latency",
      "CLIENT_TIMING": "system:client-timing",
      "PERMISSION_REQUEST": "permission:request",
      "PERMISSION_RESPONSE": "permission:response",
      "ERROR": "error"
    },
    "event_schemas": {
      "agent:chat": {
        "type": "object",
        "required": {
          "messages": { "type": "array" },
          "session_id": { "type": "string" },
          "workspace_id": { "type": "string" },
          "request_id": { "type": "string" }
        },
        "optional": {
          "pet_control_context": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
          "chat_options": { "oneOf": [{ "type": "object" }, { "type": "null" }] }
        }
      },
      "asr:speech-start": {
        "type": "object",
        "required": { "session_id": { "type": "string" }, "confirmed_ms": { "type": "number" } }
      },
      "asr:partial": {
        "type": "object",
        "required": { "session_id": { "type": "string" }, "text": { "type": "string" }, "confidence": { "type": "number" }, "lang": { "type": "string" } }
      },
      "asr:final": {
        "type": "object",
        "required": { "session_id": { "type": "string" }, "text": { "type": "string" }, "confidence": { "type": "number" }, "lang": { "type": "string" } }
      },
      "llm:delta": {
        "type": "object",
        "required": { "token": { "type": "string" }, "index": { "type": "integer" }, "session_id": { "type": "string" } }
      },
      "llm:final": {
        "type": "object",
        "required": { "text": { "type": "string" }, "session_id": { "type": "string" }, "total_tokens": { "type": "integer" }, "finish_reason": { "type": "string" } },
        "optional": { "user_message_id": { "type": "integer" }, "assistant_message_id": { "type": "integer" } }
      },
      "tts:chunk": {
        "oneOf": [
          {
            "type": "object",
            "required": { "session_id": { "type": "string" }, "generation_id": { "type": "string" }, "sequence": { "type": "integer" }, "is_final": { "const": false }, "audio_url": { "type": "string" }, "text": { "type": "string" } }
          },
          {
            "type": "object",
            "required": { "session_id": { "type": "string" }, "generation_id": { "type": "string" }, "sequence": { "type": "integer" }, "is_final": { "const": false }, "audio": { "type": "string" }, "audio_format": { "type": "string" }, "sample_rate": { "type": "integer" }, "channels": { "type": "integer" }, "sample_width_bytes": { "type": "integer" }, "chunk_index": { "type": "integer" }, "duration_ms": { "oneOf": [{ "type": "number" }, { "type": "null" }] }, "text": { "type": "string" } },
            "optional": { "visemes": { "type": "array" } }
          }
        ]
      },
      "tts:done": {
        "oneOf": [
          {
            "type": "object",
            "required": { "session_id": { "type": "string" }, "generation_id": { "type": "string" }, "sequence": { "type": "integer" }, "is_final": { "const": true }, "complete": { "const": true } }
          },
          {
            "type": "object",
            "required": { "session_id": { "type": "string" }, "generation_id": { "type": "string" }, "sequence": { "type": "integer" }, "is_final": { "const": true }, "audio_url": { "type": "string" }, "text": { "type": "string" } }
          }
        ]
      },
      "interrupt:ack": {
        "type": "object",
        "required": { "request_id": { "type": "string" }, "session_id": { "type": "string" }, "source": { "type": "string" }, "generation_id": { "type": "string" }, "hit_active_generation": { "type": "boolean" }, "server_processing_ms": { "type": "number" } }
      },
      "system:client-timing": {
        "type": "object",
        "required": { "stage": { "type": "string" }, "session_id": { "type": "string" }, "generation_id": { "type": "string" } },
        "optional": { "elapsed_ms": { "type": "number" } }
      },
      "permission:request": {
        "type": "object",
        "required": { "request_id": { "type": "string" }, "tool_name": { "type": "string" }, "capability_id": { "type": "string" }, "capability_type": { "const": "tool" }, "capability_kind": { "type": "string" }, "permission_scope": { "type": "string" }, "risk_level": { "type": "string" }, "reason": { "type": "string" }, "args": { "type": "object" } }
      }
    }
  },
  "fixture_variants": {
    "optional_event_extensions": {
      "request_id": { "type": "string" },
      "sequence": { "type": "integer" }
    },
    "E2E-02": { "tts_chunk_variant": "url", "tts_done_variant": "complete-marker" }
