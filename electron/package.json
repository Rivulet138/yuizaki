{
  "name": "yuizaki",
  "version": "0.1.0",
  "description": "Windows local AI desktop companion agent with realtime voice, vision, memory, skills, Live2D and VRM",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Yuizaki Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n main,renderer,electron -c yellow,cyan,green \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.json -w",
    "dev:renderer": "vite",
    "dev:electron": "set VITE_DEV_SERVER_URL=http://localhost:5173&& wait-on http://localhost:5173 file:dist/main/index.js && set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "npm run build:renderer && npm run audit:renderer-bundle && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.json",
    "audit:renderer-bundle": "node scripts/audit-renderer-bundle.mjs",
    "start": "set VITE_DEV_SERVER_URL=&& set ELECTRON_RUN_AS_NODE=&& electron dist/main/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@pixiv/three-vrm": "^3.5.3",
    "axios": "^1.17.0",
    "easy-live2d": "^0.4.4",
    "element-plus": "^2.14.1",
    "extract-zip": "^2.0.1",
    "pinia": "^3.0.4",
    "pixi.js": "^8.19.0",
    "screenshot-desktop": "^1.15.4",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "wait-on": "^9.0.10"
  }
}
