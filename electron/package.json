{
  "name": "yuizaki",
  "version": "0.1.2",
  "description": "Cross-platform local AI desktop companion agent with realtime voice, vision, memory, skills, Live2D and VRM",
  "private": true,
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Yuizaki Contributors",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "concurrently -k -n main,renderer,electron -c yellow,cyan,green \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "node node_modules/typescript-native/bin/tsc -p tsconfig.json -w",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/run-electron.mjs --dev",
    "build": "npm run build:renderer && npm run audit:renderer-bundle && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node node_modules/typescript-native/bin/tsc -p tsconfig.json",
    "prepare:runtime": "node scripts/prepare-package-runtime.mjs",
    "check:package-runtime": "npm run prepare:runtime && node scripts/check-package-runtime.mjs",
    "prepare:launcher": "node scripts/build-launcher.mjs --target=all",
    "prepare:launcher:win": "node scripts/build-launcher.mjs --target=windows",
    "prepare:launcher:linux": "node scripts/build-launcher.mjs --target=linux",
    "audit:renderer-bundle": "node scripts/audit-renderer-bundle.mjs",
    "install:runtime": "node -e \"require('electron')\"",
    "start": "node scripts/run-electron.mjs",
    "start:check": "node scripts/run-electron.mjs --check",
    "type-check": "node node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.json && npm run type-check:renderer",
    "lint": "eslint src",
    "test:unit": "vitest run --root .",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json}\"",
    "package:win": "npm run prepare:launcher:win && npm run prepare:runtime && npm run build && electron-builder --win nsis",
    "package:linux": "npm run prepare:launcher:linux && npm run prepare:runtime && npm run build && electron-builder --linux AppImage deb",
    "package": "npm run prepare:launcher && npm run prepare:runtime && npm run build && electron-builder",
    "type-check:renderer": "node scripts/check-renderer-types.mjs",
    "type-check:renderer:changed": "node scripts/check-renderer-types.mjs --changed",
    "type-check:renderer:update": "node scripts/check-renderer-types.mjs --update"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@pixiv/three-vrm": "^3.5.3",
    "axios": "^1.20.0",
    "easy-live2d": "^1.0.0",
    "element-plus": "^2.14.1",
    "pinia": "^4.0.3",
    "pixi.js": "^8.19.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.186.1",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.35",
    "vue-router": "^5.4.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.6",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "http-cache-semantics": "4.3.0",
    "shell-quote": "1.12.0",
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "glob@>=9": "14.0.3",
    "minimatch": "11.0.4",
    "ejs": {
      "jake": "13.0.3"
    }
  },
  "build": {
    "appId": "com.yuizaki.desktop",
    "productName": "Yuizaki",
    "artifactName": "Yuizaki-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".package-runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yuizaki"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Local-first AI desktop companion",
      "maintainer": "Yuizaki Contributors <maintainers@yuizaki.dev>"
    }
  }
}
