{
  "name": "yuizaki",
  "version": "0.1.0",
  "description": "Cross-platform local AI desktop companion agent with realtime voice, vision, memory, skills, Live2D and VRM",
  "private": true,
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Yuizaki Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n main,renderer,electron -c yellow,cyan,green \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.json -w",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/run-electron.mjs --dev",
    "build": "npm run build:renderer && npm run audit:renderer-bundle && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.json",
    "audit:renderer-bundle": "node scripts/audit-renderer-bundle.mjs",
    "install:runtime": "node -e \"require('electron')\"",
    "start": "node scripts/run-electron.mjs",
    "start:check": "node scripts/run-electron.mjs --check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json}\"",
    "test": "vitest run",
    "test:e2e:unit": "node --test scripts/__tests__/e2e-supervisor.test.mjs scripts/__tests__/e2e-lifecycle.test.mjs",
    "test:e2e:redaction": "npm run build && node --test scripts/__tests__/e2e-redaction-artifacts.test.mjs",
    "test:ci-contract": "node --test ../scripts/__tests__/verify-protected-ci.test.mjs && node ../scripts/verify-protected-ci.mjs",
    "test:e2e": "npm run build && node scripts/run-electron-e2e.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@pixiv/three-vrm": "^3.5.3",
    "axios": "^1.19.0",
    "easy-live2d": "^0.4.4",
    "element-plus": "^2.14.1",
    "pinia": "^3.0.4",
    "pixi.js": "^8.19.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.4",
    "electron": "^42.7.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "postcss": "^8.5.26",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "wait-on": "^9.0.10"
  }
}
