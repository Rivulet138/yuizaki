[
  {
    "name": "configured_healthy",
    "target": "llm",
    "config": {"llm": {"provider": "local", "model": "chat"}},
    "client_available": true,
    "probe": "healthy",
    "expected": {"configured": true, "available": true, "healthy": true}
  },
  {
    "name": "configured_runtime_unavailable",
    "target": "llm",
    "config": {"llm": {"provider": "local", "model": "chat"}},
    "client_available": false,
    "probe": "healthy",
    "expected": {"configured": true, "available": false, "healthy": false}
  },
  {
    "name": "configured_probe_failure",
    "target": "llm",
    "config": {"llm": {"provider": "local", "model": "chat"}},
    "client_available": true,
    "probe": "failure",
    "expected": {"configured": true, "available": true, "healthy": false}
  },
  {
    "name": "configured_probe_timeout",
    "target": "llm",
    "config": {"llm": {"provider": "local", "model": "chat"}},
    "client_available": true,
    "probe": "timeout",
    "expected": {"configured": true, "available": true, "healthy": false}
  },
  {
    "name": "optional_unconfigured",
    "target": "tts",
    "config": {"llm": {"provider": "local", "model": "chat"}},
    "client_available": false,
    "probe": "none",
    "expected": {"configured": false, "available": false, "healthy": false}
  },
  {
    "name": "configured_network_error",
    "target": "llm",
    "config": {"llm": {"provider": "remote", "model": "chat"}},
    "client_available": true,
    "probe": "network_error",
    "expected": {
      "configured": true,
      "available": true,
      "healthy": false,
      "retryable": true,
      "message": "Provider connection unavailable"
    }
  },
  {
    "name": "probe_failed_then_healthy",
    "target": "llm",
    "config": {"llm": {"provider": "remote", "model": "chat"}},
    "client_available": true,
    "probe_sequence": ["failure", "healthy"],
    "expected_sequence": [
      {"healthy": false, "retryable": true},
      {"healthy": true, "retryable": false}
    ]
  },
  {
    "name": "required_healthy_optional_failed",
    "config": {
      "llm": {"provider": "local", "model": "chat"},
      "tts": {"provider": "remote", "model": "voice"}
    },
    "providers": {
      "llm": {"client_available": true, "probe": "healthy"},
      "tts": {"client_available": true, "probe": "network_error"}
    },
    "expected_providers": {
      "llm": {"healthy": true, "optional": false, "retryable": false},
      "tts": {"healthy": false, "optional": true, "retryable": true}
    },
    "expected_summary": {
      "configured": 2,
      "healthy": 1,
      "requiredHealthy": true
    }
  }
]
