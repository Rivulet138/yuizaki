# Desktop Pet backend environment template
# Copy to: python/.env
# Loaded by startup scripts via: uvicorn --env-file .env

# =========================
# LLM Configuration
# =========================
LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_CONTEXT_MAX_TOKENS=131072
LLM_DEFAULT_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=1.2
LLM_TOP_P=0.9
LLM_TOP_K=500
LLM_MIN_P=0
LLM_FREQUENCY_PENALTY=0.2
LLM_PRESENCE_PENALTY=0
LLM_REPETITION_PENALTY=1
VISION_LLM_ENABLED=0
VISION_LLM_PROVIDER=custom
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
VISION_LLM_TIMEOUT=30
VISION_LLM_DETAIL=low

# =========================
# TTS Configuration
# =========================
TTS_GENIE_CHARACTER=
TTS_GENIE_MODEL_DIR=
TTS_REF_AUDIO=/path/to/ref.wav
TTS_REF_TEXT=reference text
TTS_LANG=ja
TTS_DEVICE=cpu
TTS_QUALITY=quality-first
TTS_SPLIT=smart
TTS_MODE=sequential
TTS_SAVE_MODE=disabled
AUDIO_CACHE_DIR=./audio_cache
# Keep optional TTS lazy so clean startup does not load or warm a voice model.
# Explicitly set background/1 only when you want to pay the startup cost for a faster first reply.
TTS_STARTUP_MODE=lazy
TTS_WARMUP_ENABLED=0
# Set TTS_PROVIDER=openai-compatible for an OpenAI-compatible /v1/audio/speech service.
TTS_PROVIDER=genie-tts
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_TIMEOUT=60

# =========================
# ASR Configuration (streaming Sherpa ONNX by default)
# =========================
ASR_PROVIDER=sherpa-onnx-online
ASR_BASE_URL=
ASR_API_KEY=
ASR_TIMEOUT=60
SENSEVOICE_MODEL=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cpu
# Leave these empty to use the provider-specific managed model directory.
SHERPA_ONNX_MODEL_PATH=
SHERPA_ONNX_TOKENS_PATH=
SHERPA_ONNX_NUM_THREADS=2
SHERPA_ONNX_PROVIDER=cpu
# Local Sherpa model startup: lazy (default), background, or blocking.
ASR_STARTUP_MODE=lazy
ASR_LANGUAGE=zh
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=300
ASR_PARTIAL_EVERY=15

# =========================
# SVC Configuration
# =========================
SVC_PROVIDER=soulx-service
SVC_BASE_URL=http://127.0.0.1:7861
SVC_SPEAKER_ID=0
SVC_PITCH=0
SVC_TIMEOUT=120

# =========================
# Cache / Runtime Cleanup
# =========================
CACHE_MAX_AGE=1800
CACHE_JANITOR_INTERVAL=600

# =========================
# Frontend / CORS Origins
# =========================
# Comma-separated allowed browser origins for Python FastAPI and Electron control service.
YUIZAKI_ALLOWED_ORIGINS=http://127.0.0.1:38945,http://localhost:38945,http://127.0.0.1:5173,http://localhost:5173
# Non-loopback backend clients require this token. Loopback HTTP and Socket.IO access is trusted.
YUIZAKI_BACKEND_API_TOKEN=

# =========================
# Database / Persistence
# =========================
DATABASE_URL=sqlite:///./data/chat.db

# =========================
# Memory / RAG
# =========================
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=./data/memory.db
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memories
QDRANT_TIMEOUT=10
QDRANT_AUTO_START=0
QDRANT_DOCKER_IMAGE=qdrant/qdrant:v1.18.3
QDRANT_DOCKER_CONTAINER=yuizaki-qdrant
QDRANT_DOCKER_VOLUME=yuizaki-qdrant-storage
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Optional: absolute/local path preferred by the backend when available
EMBEDDING_MODEL_LOCAL_PATH=
MEMORY_RERANKER_ENABLED=0
MEMORY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MEMORY_RERANKER_CANDIDATES=32

# =========================
# Summary Governance
# =========================
SUMMARY_TRIGGER_MESSAGES=24
SUMMARY_KEEP_RECENT_MESSAGES=8
SUMMARY_ITEM_MAX_CHARS=140
SUMMARY_REWRITE_INTERVAL_MESSAGES=6
SUMMARY_QUALITY_SCORER_MODE=rule
SUMMARY_QUALITY_SCORE_COOLDOWN_SECONDS=300
SUMMARY_QUALITY_SCORE_BUDGET_PER_HOUR=20

# =========================
# Server / Logging
# =========================
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
# Note: frontend/backend origins are configurable via YUIZAKI_ALLOWED_ORIGINS
# and renderer VITE_YUIZAKI_* variables; keep defaults for local use.
CONTROL_SERVER_PORT=38945
SERVER_DEBUG=false

LOG_LEVEL=INFO
